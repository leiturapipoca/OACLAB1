`ifndef PARAM
	`include "Parametros.v"
`endif


module Controle(
	input logic [6:0] iOpcode,
	
	// Sinais de Controle de Saída
    output logic       oRegWrite,   // Habilita escrita no Banco de Registradores
    output logic       oALUSrc,     // MUX da ULA B (0: Reg[rs2], 1: Imediato)
    output logic [1:0] oMemToReg,   // MUX de Write-Back (00: ULA, 01: Mem, 10: PC+4)
    output logic       oMemRead,    // Habilita leitura da Memória de Dados
    output logic       oMemWrite,   // Habilita escrita na Memória de Dados
    output logic       oBranch,     // Sinal 'beq' (usado com 'Zero' da ULA)
    output logic       oJump,       // Sinal 'jal'
    output logic       oJumpReg,    // Sinal 'jalr'
    output logic [1:0] oALUOp       // Sinal para o 'Controlador_ULA' (00:L/S, 01:Beq, 10:R, 11:I)

);

always @(*)
    begin
        // --- Valores Padrão (Default) ---
        // Desliga tudo por padrão para evitar latches
        oRegWrite = 1'b0;
        oALUSrc   = 1'b0;
        oMemToReg = 2'b00; // 2'bXX (Don't Care)
        oMemRead  = 1'b0;
        oMemWrite = 1'b0;
        oBranch   = 1'b0;
        oJump     = 1'b0;
        oJumpReg  = 1'b0;
        oALUOp    = 2'b00; // Padrão
        
        // --- Decodificação do Opcode ---
        case (iOpcode)
            
            // Tipo R (add, sub, and, or, slt)
            OPC_RTYPE:
            begin
                oRegWrite = 1'b1;     // Escreve no registrador 'rd'
                oALUSrc   = 1'b0;     // ULA B recebe Reg[rs2]
                oMemToReg = 2'b00;    // Escreve o resultado da ULA
                oALUOp    = 2'b10;    // Diz ao Controlador_ULA que é Tipo-R
            end

            // Tipo I - Imediato (addi)
            OPC_OPIMM:
            begin
                oRegWrite = 1'b1;     // Escreve no registrador 'rd'
                oALUSrc   = 1'b1;     // ULA B recebe Imediato
                oMemToReg = 2'b00;    // Escreve o resultado da ULA
                oALUOp    = 2'b11;    // Diz ao Controlador_ULA que é Tipo-I
            end

            // Tipo I - Load (lw)
            OPC_LOAD:
            begin
                oRegWrite = 1'b1;     // Escreve no registrador 'rd'
                oALUSrc   = 1'b1;     // ULA B recebe Imediato (offset)
                oMemToReg = 2'b01;    // Escreve o dado vindo da Memória
                oMemRead  = 1'b1;     // Lê da Memória de Dados
                oALUOp    = 2'b00;    // Diz ao Controlador_ULA que é LW/SW
            end

            // Tipo S - Store (sw)
            OPC_STORE:
            begin
                // Sem oRegWrite
                oALUSrc   = 1'b1;     // ULA B recebe Imediato (offset)
                oMemWrite = 1'b1;     // Escreve na Memória de Dados
                oALUOp    = 2'b00;    // Diz ao Controlador_ULA que é LW/SW
            end

            // Tipo B - Branch (beq)
            OPC_BRANCH:
            begin
                // Sem oRegWrite
                oALUSrc   = 1'b0;     // ULA B recebe Reg[rs2] (para comparar com rs1)
                oBranch   = 1'b1;     // Habilita lógica do 'beq'
                oALUOp    = 2'b01;    // Diz ao Controlador_ULA que é 'beq'
            end

            // Tipo J - Jump and Link (jal)
            OPC_JAL:
            begin
                oRegWrite = 1'b1;     // Escreve no registrador 'rd'
                oMemToReg = 2'b10;    // Escreve o valor de PC+4
                oJump     = 1'b1;     // Habilita lógica do 'jal' (Mux do PC)
                // oALUOp não importa
            end

            // Tipo I - Jump and Link Register (jalr)
            OPC_JALR:
            begin
                oRegWrite = 1'b1;     // Escreve no registrador 'rd'
                oALUSrc   = 1'b1;     // ULA B recebe Imediato
                oMemToReg = 2'b10;    // Escreve o valor de PC+4
                oJumpReg  = 1'b1;     // Habilita lógica do 'jalr' (Mux do PC)
                oALUOp    = 2'b11;    // Diz ao Controlador_ULA que é Tipo-I (para ULA fazer rs1 + imm)
            end
            
        endcase
    end
endmodule